{
  "name": "globeride",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Open-source browser-based virtual cycling simulator. Ride anywhere on Earth with real-world GPX routes, photorealistic 3D terrain, and live FTMS smart trainer integration.",
  "author": "Mason Wyatt",
  "homepage": "https://github.com/masonwyatt23/globeride",
  "repository": {
    "type": "git",
    "url": "https://github.com/masonwyatt23/globeride.git"
  },
  "keywords": [
    "cycling",
    "virtual-cycling",
    "cesium",
    "gpx",
    "fit",
    "ftms",
    "web-bluetooth",
    "kickr",
    "smart-trainer",
    "pwa"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen-avatar": "vite-node scripts/gen-avatar-gltf.ts",
    "lint": "eslint src",
    "check": "npm run typecheck && npm run lint && npm test",
    "vercel-build": "npm run check && vite build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.1.1",
    "cesium": "^1.131.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-is": "^19.2.6",
    "react-router-dom": "^7.1.1",
    "recharts": "^3.0.0",
    "tailwind-merge": "^2.5.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/web-bluetooth": "^0.0.20",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.59.4",
    "vite": "^6.0.7",
    "vite-plugin-cesium": "^1.2.23",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.9"
  }
}
