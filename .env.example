# GlobeRide environment variables — copy to .env.local and fill in real values.
# .env.local is gitignored and should NEVER be committed.

# ── Cesium ion (required for 3D globe rendering) ─────────────────────────────
# Free personal token at https://ion.cesium.com/tokens
VITE_CESIUM_ION_TOKEN=

# ── Strava direct upload (optional — personal use only) ──────────────────────
# Create a Strava API application at https://www.strava.com/settings/api
# then generate a long-lived refresh token (scope: activity:write) via the
# OAuth flow in your other project that already has one.
#
# All Strava HTTP is proxied through /strava-api in dev+preview (vite.config.ts).
# In production you need a server-side proxy forwarding /strava-api/* →
# https://www.strava.com/* — see vite.config.ts for the rewrite rule.
#
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_CLIENT_SECRET=
VITE_STRAVA_REFRESH_TOKEN=
